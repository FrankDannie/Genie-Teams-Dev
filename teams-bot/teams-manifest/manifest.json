      "botId": "PASTE-YOUR-BOT-MICROSOFTAPPID-HERE",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
